# NFIL3D static site on Hostinger (Apache / LiteSpeed)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On
# Force HTTPS and the bare domain
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://nfil3d.com%{REQUEST_URI} [L,R=301]

# Add trailing slash to folder-style URLs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(\.[a-zA-Z0-9]{1,5}|/)$
RewriteRule ^(.*)$ /$1/ [L,R=301]

# Old WordPress URLs → new pages (keeps Google rankings)
RewriteRule ^support-2/?$ /support/ [L,R=301]
RewriteRule ^blog-page/?$ /blog/ [L,R=301]
RewriteRule ^models/?$ /product-category/3d-models/ [L,R=301]
RewriteRule ^home/?$ / [L,R=301]
RewriteRule ^sample-page/?$ / [L,R=301]
RewriteRule ^product-category/best-seller/?(.*)$ /shop/ [L,R=301]

# Store pages live on WooCommerce. Change shop.nfil3d.com if WordPress lives elsewhere.
# Uncomment these once WordPress has moved to the store subdomain:
# RewriteRule ^(cart|checkout|my-account|wishlist|login)(/.*)?$ https://shop.nfil3d.com/$1$2 [L,R=302,QSA]
# RewriteRule ^wp-(admin|login\.php)(.*)$ https://shop.nfil3d.com/wp-$1$2 [L,R=302,QSA]

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  <FilesMatch "\.(css|js|woff2|webp|png|jpg|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain text/xml
</IfModule>
