---
import { SITE } from '../config/site';
interface Props { items: { name: string; href?: string }[] }
const { items } = Astro.props;
const all = [{ name: 'Home', href: '/' }, ...items];
const ld = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: all.map((it, i) => ({ '@type': 'ListItem', position: i + 1, name: it.name, ...(it.href ? { item: new URL(it.href, SITE.url).href } : {}) })) };
---
<nav aria-label="Breadcrumb" class="crumbs">
  <ol>
    {all.map((it, i) => <li>{it.href && i < all.length - 1 ? <a href={it.href}>{it.name}</a> : <span aria-current="page">{it.name}</span>}</li>)}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
<style>
  .crumbs ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; font-size: .86rem; color: var(--muted); }
  .crumbs li + li::before { content: '/'; margin-right: 6px; opacity: .5; }
  .crumbs a { text-decoration: none; }
  .crumbs [aria-current] { color: var(--ink); }
</style>
