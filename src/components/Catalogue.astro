---
// Product grid with search, material filter and sort. Works without JS (shows all).
import ProductCard from './ProductCard.astro';
import type { Product } from '../lib/data';
import { material } from '../lib/data';
interface Props { items: Product[]; search?: boolean; filters?: boolean }
const { items, search = false, filters = true } = Astro.props;
const mats = [['all', 'All'], ['pla', 'PLA+'], ['petg', 'PETG'], ['abs', 'ABS, ASA & HIPS'], ['special', 'Speciality'], ['pen', '3D pens'], ['printer', 'Printers & more']]
  .filter(([k]) => k === 'all' || items.some((p) => material(p) === k));
---
<div data-cat>
  <div class="tools">
    {search && (
      <div class="search" id="search">
        <label class="sr-only" for="q">Search products</label>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        <input id="q" type="search" placeholder="Search colour, material or product" data-q autocomplete="off">
      </div>
    )}
    {filters && mats.length > 2 && (
      <div class="row gap-8" role="group" aria-label="Filter by material">
        {mats.map(([k, l], i) => <button type="button" class="chip" aria-pressed={i === 0 ? 'true' : 'false'} data-m={k}>{l}</button>)}
      </div>
    )}
    <div class="row gap-12 meta">
      <span class="muted" data-count aria-live="polite">{items.length} products</span>
      <label class="row gap-8 muted">Sort
        <select class="input sort" data-sort>
          <option value="">Featured</option>
          <option value="low">Price: low to high</option>
          <option value="high">Price: high to low</option>
          <option value="name">Name</option>
        </select>
      </label>
    </div>
  </div>
  <div class="grid cols-4" data-grid>
    {items.map((p, i) => <ProductCard p={p} eager={i < 4} />)}
  </div>
  <p class="empty muted" data-empty hidden>No products match. Try another colour or material.</p>
  <div class="more-wrap"><button type="button" class="btn btn-ghost" data-more hidden>Show more</button></div>
</div>
<style>
  .tools { display: flex; flex-direction: column; gap: 16px; margin-bottom: 28px; }
  .search { display: flex; align-items: center; gap: 10px; padding: 0 18px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); max-width: 560px; transition: border-color .2s; }
  .search:focus-within { border-color: var(--ink); }
  .search input { flex: 1; border: 0; background: transparent; min-height: 52px; outline: none; font-size: 1rem; }
  .meta { justify-content: space-between; font-size: .9rem; }
  .sort { min-height: 40px; padding: 6px 12px; width: auto; border-radius: 999px; }
  .empty { padding: 48px 0; text-align: center; }
  .more-wrap { display: flex; justify-content: center; margin-top: 32px; }
  .more-wrap .btn[hidden] { display: none; }
</style>
<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  document.querySelectorAll<HTMLElement>('[data-cat]').forEach((root) => {
    const grid = root.querySelector<HTMLElement>('[data-grid]')!;
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-product]'));
    const original = [...cards];
    const q = root.querySelector<HTMLInputElement>('[data-q]');
    const sort = root.querySelector<HTMLSelectElement>('[data-sort]')!;
    const count = root.querySelector('[data-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const more = root.querySelector<HTMLButtonElement>('[data-more]')!;
    const PAGE = matchMedia('(max-width: 760px)').matches ? 12 : 24;
    let limit = PAGE;
    let m = 'all';
    const params = new URLSearchParams(location.search);
    if (q && params.get('q')) q.value = params.get('q')!;
    const apply = (reset = true) => {
      if (reset) limit = PAGE;
      const term = (q?.value || '').trim().toLowerCase();
      const order = sort.value === 'low' ? [...cards].sort((a, b) => +a.dataset.price! - +b.dataset.price!)
        : sort.value === 'high' ? [...cards].sort((a, b) => +b.dataset.price! - +a.dataset.price!)
        : sort.value === 'name' ? [...cards].sort((a, b) => a.dataset.name!.localeCompare(b.dataset.name!)) : original;
      let matched = 0;
      const fresh: HTMLElement[] = [];
      order.forEach((c) => {
        grid.appendChild(c);
        const ok = (m === 'all' || c.dataset.mat === m) && (!term || c.dataset.name!.includes(term) || c.dataset.colour!.includes(term));
        const show = ok && matched < limit;
        if (ok) matched++;
        if (show && c.hidden) fresh.push(c);
        c.hidden = !show;
        if (show) c.classList.add('in');
      });
      count.textContent = `${matched} product${matched === 1 ? '' : 's'}`;
      empty.hidden = matched > 0;
      const left = matched - limit;
      more.hidden = left <= 0;
      more.textContent = `Show more (${left} left)`;
      if (fresh.length) gsap.fromTo(fresh, { autoAlpha: 0, y: 24 }, { autoAlpha: 1, y: 0, duration: 0.7, ease: 'expo.out', stagger: 0.03, overwrite: true });
      ScrollTrigger.refresh();
    };
    root.querySelectorAll<HTMLButtonElement>('[data-m]').forEach((b, _, all) => b.addEventListener('click', () => {
      all.forEach((x) => x.setAttribute('aria-pressed', String(x === b))); m = b.dataset.m!; apply();
    }));
    q?.addEventListener('input', () => apply());
    sort.addEventListener('change', () => apply());
    more.addEventListener('click', () => { limit += PAGE; apply(false); });
    apply();
    if (location.hash === '#search') q?.focus();
  });
</script>
