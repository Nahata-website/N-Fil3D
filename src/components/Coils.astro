---
// Coiled 3D-pen filament rings drawn as SVG, one per colour.
const { colors = ['#1E8BFF', '#FFD21F', '#FF3FA4', '#FF7A1A', '#8A3FFF', '#2DBE4E'], class: cls = '' } = Astro.props as { colors?: string[]; class?: string };
---
<div class={`coils ${cls}`} aria-hidden="true">
  {colors.map((c, i) => (
    <svg class="coil" viewBox="0 0 200 90" style={`--i:${i}`}>
      {[0, 1, 2, 3, 4, 5, 6].map((k) => (
        <ellipse cx="100" cy={44 - k * 3.2} rx={92 - k * 1.4} ry={34 - k * 0.8} fill="none" stroke={c} stroke-width="7" opacity={1 - k * 0.04} />
      ))}
      <ellipse cx="100" cy="24" rx="58" ry="17" fill="none" stroke="rgba(255,255,255,.55)" stroke-width="2" />
    </svg>
  ))}
</div>
<style>
  .coils { position: absolute; display: flex; align-items: flex-end; pointer-events: none; }
  .coil { flex: 1 1 0; min-width: 0; height: auto; margin-left: -4%; filter: drop-shadow(0 10px 10px rgba(17,17,16,.18)); }
  .coil:first-child { margin-left: 0; }
  .coil:nth-child(even) { margin-bottom: 3%; }
</style>
