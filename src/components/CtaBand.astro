---
interface Props { title: string; text?: string; href: string; label: string; second?: { href: string; label: string } }
const { title, text, href, label, second } = Astro.props;
---
<section class="band reveal">
  <div class="wrap band-in">
    <div class="stack gap-8"><p class="band-t">{title}</p>{text && <p class="band-s">{text}</p>}</div>
    <div class="row gap-16 band-a">
      <a class="btn btn-lg band-btn" href={href}>{label} <span class="arrow" aria-hidden="true">→</span></a>
      {second && <a class="band-link" href={second.href}>{second.label} <span aria-hidden="true">→</span></a>}
    </div>
  </div>
</section>
<style>
  .band { background: var(--sun); color: #111110; margin-top: clamp(40px, 6vw, 80px); }
  .band-in { display: flex; flex-wrap: wrap; gap: 20px 40px; justify-content: space-between; align-items: center; padding-block: clamp(28px, 4vw, 44px); }
  .band-t { margin: 0; font-size: clamp(1.6rem, 3vw, 2.6rem); font-weight: 600; letter-spacing: -0.035em; line-height: 1.05; }
  .band-s { margin: 0; color: #3B3214; }
  .band-btn { --b: #111110; color: #FFFFFF; }
  .band-btn::after { background: #2A2A28; }
  .band-link { color: #111110; font-weight: 600; text-decoration: none; }
  .band-a { align-items: center; flex-wrap: wrap; }
</style>
