---
import { SITE } from '../config/site';
const nav = [
  { label: 'Filament', href: '/product-category/3d-printer-filaments/', menu: [
    { label: 'PLA+', href: '/product-category/3d-printer-filaments/pla/', note: 'Easiest to print' },
    { label: 'PETG', href: '/product-category/3d-printer-filaments/petg/', note: 'Strong and heat-resistant' },
    { label: 'HI ABS+', href: '/product-category/3d-printer-filaments/abs-3d-printer-filaments/', note: 'Tough, impact-resistant' },
    { label: 'Turbo-Finish PLA+', href: '/product-category/3d-printer-filaments/pla_tf/', note: 'Clean surface at speed' },
    { label: 'Matte PLA+', href: '/product-category/matte_pla/', note: 'Non-shiny finish' },
    { label: 'Carbon fibre', href: '/product-category/pla_cf/', note: 'Stiff, matte black' },
    { label: 'ASA & ABS FR', href: '/product-category/3d-printer-filaments/abs-fr/', note: 'Outdoor, flame-retardant' },
    { label: 'Nylon & speciality', href: '/product-category/speciality-filaments/', note: 'Engineering grades' },
  ]},
  { label: '3D Printers', href: '/printers/', menu: [
    { label: 'Mini-N', href: '/product/mini-n-3d-printer/', note: 'Compact, for desks and classrooms' },
    { label: 'N1', href: '/product/n1-3d-printer/', note: 'Prototypes and everyday parts' },
    { label: 'N2', href: '/product/n2-3d-printer/', note: 'Bigger, longer prints' },
    { label: 'Resin printers', href: '/product-category/3d-printers/resin-3d-printers/', note: 'Halot Sky, Max and One' },
    { label: 'Wash & cure', href: '/product/all-in-one-washing-and-curing-station-uw-02/', note: 'UW-02 station' },
    { label: 'Compare printers', href: '/printers/#fit', note: 'Side by side' },
  ]},
  { label: '3D Pens', href: '/product-category/3d-pen/', menu: [
    { label: '3D pen kits', href: '/product-category/3d-pen/', note: '3, 9 or 14 filaments' },
    { label: 'Pen filaments', href: '/product-category/3d-pens-filaments/', note: 'Refill packs, 6 to 51 colours' },
  ]},
  { label: 'Scanners', href: '/product-category/3d-scanner/', menu: [
    { label: 'Magic Swift Plus', href: '/product/magic-swift-plus-3d-scanner-premium/', note: 'Handheld 3D scanner' },
    { label: 'Mole', href: '/product/mole-3d-scanner-for-3d-printing-premium/', note: '3D scanner for printing' },
  ]},
  { label: '3D Models', href: '/product-category/3d-models/' },
  { label: 'Learn', href: '/get-started/', menu: [
    { label: 'Get Started', href: '/get-started/', note: 'Settings and storage' },
    { label: 'Compare materials', href: '/materials/', note: 'PLA vs PETG vs ABS' },
    { label: '3D Printing FAQ', href: '/3d-printing-faq/', note: 'Quick answers' },
    { label: 'Brand Story', href: '/brand-story/', note: 'Who makes NFIL3D' },
  ]},
  { label: 'Blog', href: '/blog/' },
  { label: 'About us', href: '/about-us/', menu: [
    { label: 'About NFIL3D', href: '/about-us/', note: 'Who we are, facility and testing' },
    { label: 'Brand Story', href: '/brand-story/', note: 'How NFIL3D began' },
  ]},
];
const path = Astro.url.pathname;
---
<header class="hdr" data-hdr>
  <div class="wrap hdr-in">
    <a href="/" class="logo" aria-label="NFIL3D home">
      <img src="/images/logo-dark.png" alt="NFIL3D" width="88" height="40" class="logo-l">
      <img src="/images/logo-light.png" alt="" width="88" height="40" class="logo-d" aria-hidden="true">
    </a>
    <nav aria-label="Main" class="nav-wide">
      <ul class="nav">
        {nav.map((n) => (
          <li class={n.menu ? 'has-menu' : ''}>
            <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}{n.menu && <svg class="chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>}</a>
            {n.menu && (
              <div class="menu">
                <ul>
                  {n.menu.map((m) => <li><a href={m.href}><span>{m.label}</span><small>{m.note}</small></a></li>)}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div class="row hdr-actions">
      <form class="hsearch" action="/shop/" method="get" role="search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        <label class="sr-only" for="hq">Search products</label>
        <input id="hq" name="q" type="search" placeholder="Search products…" autocomplete="off">
      </form>
      <a href="/shop/#search" class="icon-btn s-icon" aria-label="Search products"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg></a>
      <button type="button" class="icon-btn" data-theme-toggle aria-label="Switch colour theme"><svg class="i-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg><svg class="i-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20 14.5A8 8 0 019.5 4a8 8 0 1010.5 10.5z"/></svg></button>
      <a href={`${SITE.storeUrl}/my-account/`} class="icon-btn acct" aria-label="Account"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg></a>
      <a href={`${SITE.storeUrl}/cart/`} class="icon-btn" aria-label="Cart"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M5 7h14l-1.2 11.2a2 2 0 01-2 1.8H8.2a2 2 0 01-2-1.8z"/><path d="M9 7V6a3 3 0 016 0v1"/></svg></a>
      <button type="button" class="icon-btn menu-btn" data-menu-open aria-label="Open menu" aria-controls="mnav" aria-expanded="false"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg></button>
    </div>
  </div>
  <div id="mnav" class="mnav" hidden>
    <nav aria-label="Mobile" class="wrap">
      <ul>
        {nav.map((n) => (
          <li>
            <a href={n.href}>{n.label}</a>
            {n.menu && <ul class="sub">{n.menu.map((m) => <li><a href={m.href}>{m.label}</a></li>)}</ul>}
          </li>
        ))}
        <li><a href="/bulk/">Bulk &amp; B2B</a></li>
        <li><a href="/support/">Support</a></li>
        <li><a href={`${SITE.storeUrl}/my-account/`}>Account</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .hsearch { display: flex; align-items: center; gap: 10px; padding: 0 18px; height: 46px; width: 196px; border-radius: 999px; background: var(--surface-2); border: 1px solid transparent; transition: border-color .2s, background-color .2s; color: var(--muted); margin-right: 6px; }
  .hsearch:focus-within { border-color: var(--ink); background: var(--surface); }
  .hsearch input { flex: 1; min-width: 0; border: 0; background: transparent; outline: none; font-size: .9rem; color: var(--ink); }
  .icon-btn.s-icon { display: none; }
  @media (max-width: 1700px) { .hsearch { width: 44px; padding: 0; justify-content: center; background: transparent; } .hsearch input { display: none; } .hsearch:focus-within { width: 260px; padding: 0 16px; } .hsearch:focus-within input { display: block; } }
  @media (max-width: 1240px) { .hsearch { display: none; } .icon-btn.s-icon { display: grid; } }
  .chev { margin-left: 4px; vertical-align: -1px; transition: transform .3s var(--ease); }
  .has-menu:hover .chev { transform: rotate(180deg); }
  .hdr { position: sticky; top: 0; z-index: 50; background: linear-gradient(180deg, color-mix(in srgb, var(--bg) 72%, transparent), color-mix(in srgb, var(--bg) 52%, transparent)); backdrop-filter: saturate(1.9) blur(22px); -webkit-backdrop-filter: saturate(1.9) blur(22px); border-bottom: 1px solid transparent; transition: border-color .3s, box-shadow .4s, background-color .4s; }
  .hdr::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 1px; background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--ink) 14%, transparent) 20%, color-mix(in srgb, var(--ink) 14%, transparent) 80%, transparent); opacity: 0; transition: opacity .3s; pointer-events: none; }
  .hdr::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 1px; background: linear-gradient(90deg, transparent, rgba(255,255,255,.55), transparent); pointer-events: none; }
  :global([data-theme="dark"]) .hdr::before { opacity: .12; }
  .hdr.scrolled { box-shadow: 0 10px 30px -18px rgba(17,17,16,.25); }
  .hdr.scrolled::after { opacity: 1; }
  .hdr-in { display: flex; align-items: center; gap: 14px; min-height: 78px; }
  .logo { display: flex; flex: none; }
  .logo img { height: 46px; width: auto; }
  .logo-d { display: none; }
  :global([data-theme="dark"]) .logo-l { display: none; }
  :global([data-theme="dark"]) .logo-d { display: block; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme="light"])) .logo-l { display: none; } :global(:root:not([data-theme="light"])) .logo-d { display: block; } }
  nav[aria-label="Main"] { flex: 1; }
  .nav { list-style: none; margin: 0; padding: 0; display: flex; justify-content: center; gap: clamp(0px, .35vw, 8px); flex-wrap: nowrap; }
  .nav > li { position: relative; }
  .nav > li > a { display: block; padding: 9px clamp(9px, .7vw, 14px); border-radius: 999px; text-decoration: none; font-size: .9rem; font-weight: 500; white-space: nowrap; color: var(--ink-2); transition: color .2s, background-color .2s; }
  .nav > li > a:hover, .nav > li > a[aria-current] { color: var(--ink); background: color-mix(in srgb, var(--surface) 70%, transparent); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ink) 8%, transparent), inset 0 1px 0 rgba(255,255,255,.5); }
  .menu { position: absolute; top: calc(100% + 8px); left: -8px; min-width: 520px; padding: 10px; background: color-mix(in srgb, var(--surface) 90%, transparent); backdrop-filter: saturate(1.8) blur(28px); -webkit-backdrop-filter: saturate(1.8) blur(24px); border: 1px solid color-mix(in srgb, var(--ink) 9%, transparent); border-radius: 22px; box-shadow: 0 24px 60px -24px rgba(17,17,16,.35), inset 0 1px 0 rgba(255,255,255,.5); opacity: 0; visibility: hidden; transform: translateY(-6px) scale(.98); transform-origin: top left; transition: opacity .25s var(--ease), transform .35s var(--ease), visibility .25s; }
  .nav > li:nth-last-child(-n+3) .menu { left: auto; right: -8px; transform-origin: top right; }
  .menu::before { content: ''; position: absolute; inset: -12px 0 auto 0; height: 12px; }
  .has-menu:hover .menu, .has-menu:focus-within .menu { opacity: 1; visibility: visible; transform: none; }
  .menu ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 2px; }
  .menu a { display: flex; flex-direction: column; padding: 12px 14px; border-radius: 14px; text-decoration: none; transition: background-color .2s; }
  .menu a:hover { background: color-mix(in srgb, var(--surface-2) 70%, transparent); color: var(--ink); }
  .menu span { font-weight: 550; font-size: .95rem; }
  .menu small { color: var(--muted); font-size: .82rem; }
  .hdr-actions { gap: 2px; margin-left: auto; flex-wrap: nowrap !important; flex: none; }
  .icon-btn.menu-btn { display: none; }
  @media (max-width: 1240px) { .nav-wide, .acct { display: none !important; } .icon-btn.menu-btn { display: grid; } }
  .icon-btn { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; border: 0; background: transparent; color: var(--ink); cursor: pointer; transition: background-color .2s, transform .3s var(--ease); }
  .icon-btn:hover { background: color-mix(in srgb, var(--surface) 70%, transparent); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ink) 8%, transparent); color: var(--ink); }
  .i-moon { display: none; }
  :global([data-theme="dark"]) .i-sun { display: none; }
  :global([data-theme="dark"]) .i-moon { display: block; }
  .mnav { border-top: 1px solid var(--line); background: color-mix(in srgb, var(--bg) 80%, transparent); backdrop-filter: saturate(1.8) blur(22px); -webkit-backdrop-filter: saturate(1.8) blur(22px); max-height: calc(100vh - 68px); overflow: auto; }
  .mnav ul { list-style: none; margin: 0; padding: 12px 0 28px; }
  .mnav li a { display: block; padding: 12px 0; font-size: 1.35rem; font-weight: 500; text-decoration: none; letter-spacing: -0.02em; }
  .mnav .sub { padding: 0 0 8px 14px; border-left: 1px solid var(--line); }
  .mnav .sub a { font-size: 1rem; padding: 8px 0; color: var(--ink-2); }
</style>

<script>
  const hdr = document.querySelector('[data-hdr]');
  const onScroll = () => hdr?.classList.toggle('scrolled', window.scrollY > 8);
  onScroll(); window.addEventListener('scroll', onScroll, { passive: true });
  const btn = document.querySelector('[data-menu-open]') as HTMLButtonElement | null;
  const panel = document.getElementById('mnav');
  btn?.addEventListener('click', () => {
    const open = panel!.hidden;
    panel!.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const root = document.documentElement;
    const isDark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    root.dataset.theme = isDark ? 'light' : 'dark';
    try { localStorage.setItem('theme', root.dataset.theme); } catch {}
  });
</script>
