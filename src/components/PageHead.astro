---
import Breadcrumbs from './Breadcrumbs.astro';
interface Props { eyebrow?: string; title: string; lead?: string; crumb: string; image?: string; imageAlt?: string }
const { eyebrow, title, lead, crumb, image, imageAlt = '' } = Astro.props;
---
<section class={`phead ${image ? 'has-img' : ''}`}>
  <div class="wrap ph-in">
    <div class="stack gap-16 ph">
      <Breadcrumbs items={[{ name: crumb }]} />
      {eyebrow && <span class="eyebrow ph-eb">{eyebrow}</span>}
      <h1 class="h-display ph-h" set:html={title} />
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
  </div>
  {image && <div class="ph-img"><img src={image} alt={imageAlt} width="1200" height="900" fetchpriority="high"></div>}
</section>
<style>
  .phead { position: relative; overflow: hidden; background: var(--surface-2); margin-bottom: clamp(24px, 4vw, 48px); }
  .ph-in { position: relative; z-index: 1; padding-block: clamp(20px, 3vw, 32px) clamp(36px, 5vw, 64px); }
  .ph { max-width: 640px; }
  .ph-eb { color: #C99A00; }
  .ph-h { font-size: clamp(2.4rem, 5vw, 4.6rem); line-height: .98; margin: 0; }
  .ph .lead { margin: 0; }
  .ph-img { position: absolute; top: 0; right: 0; bottom: 0; width: 46%; -webkit-mask-image: linear-gradient(90deg, transparent, #000 28%); mask-image: linear-gradient(90deg, transparent, #000 28%); }
  .ph-img img { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 900px) { .ph-img { position: relative; width: 100%; height: 240px; -webkit-mask-image: none; mask-image: none; } }
</style>
