---
// Illustrated 3D pen (SVG shapes), drawn horizontally with the nib on the left.
const { class: cls = '' } = Astro.props as { class?: string };
---
<svg class={`pen-art ${cls}`} viewBox="0 0 520 120" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="penBody" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FFE45C" />
      <stop offset=".45" stop-color="#FFCC1A" />
      <stop offset="1" stop-color="#E0A800" />
    </linearGradient>
    <linearGradient id="penBlack" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#3A3A38" />
      <stop offset="1" stop-color="#0E0E0D" />
    </linearGradient>
  </defs>
  <path d="M4 60 L46 50 L46 70 Z" fill="#1B1B1A" />
  <path d="M44 42 Q60 38 92 34 L92 86 Q60 82 44 78 Z" fill="url(#penBlack)" />
  <g fill="none" stroke="#5A5A57" stroke-width="2"><path d="M54 44v32" /><path d="M64 42v36" /><path d="M74 40v40" /></g>
  <rect x="88" y="26" width="380" height="68" rx="34" fill="url(#penBody)" />
  <rect x="452" y="28" width="62" height="64" rx="28" fill="url(#penBlack)" />
  <rect x="300" y="40" width="96" height="22" rx="11" fill="#151514" />
  <rect x="312" y="45" width="48" height="12" rx="4" fill="#2E3A33" />
  <rect x="210" y="40" width="30" height="16" rx="8" fill="#151514" />
  <rect x="250" y="40" width="30" height="16" rx="8" fill="#151514" />
  <g stroke="#B88A00" stroke-width="4" stroke-linecap="round"><path d="M130 70h22" /><path d="M130 80h22" /><path d="M164 70h22" /><path d="M164 80h22" /></g>
  <path d="M100 34 Q280 28 460 34" fill="none" stroke="#FFF3B0" stroke-width="4" stroke-linecap="round" opacity=".7" />
</svg>
