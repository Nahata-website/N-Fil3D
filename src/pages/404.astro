---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | NFIL3D" description="This page could not be found." noindex>
  <section class="wrap section" style="text-align:center;max-width:720px">
    <p class="mono muted">Error 404</p>
    <h1 class="h-display" style="margin:16px 0">Off by more than <span class="serif">0.015 mm.</span></h1>
    <p class="lead" style="margin:0 auto 28px">We could not find that page. It may have moved in our redesign.</p>
    <div class="row gap-12" style="justify-content:center"><a class="btn btn-accent" href="/">Go home</a><a class="btn btn-ghost" href="/shop/">Shop all products</a></div>
  </section>
</Base>
