---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { pimg } from '../lib/data';

const stats = [['37+ years', 'Polymer experience'], ['4 lakh sq. ft.', 'Manufacturing facility'], ['In-house', 'Testing & development']];
const offers = [
  ['Filaments', '/product-category/3d-printer-filaments/', pimg('premium-hs-pla-fluoro-yellow-1-75mm', 1)],
  ['3D Printers', '/printers/', pimg('n2-3d-printer', 0)],
  ['3D Pens', '/product-category/3d-pen/', pimg('nfil3d-pen-for-kids-adults-nfil3d', 1)],
  ['Spares & Accessories', '/product-category/accessories-and-spares/', pimg('all-in-one-washing-and-curing-station-uw-02', 0)],
] as const;
const tests = [
  ['Thermal testing', 'Heat resistance and material stability.'],
  ['Mechanical testing', 'Strength, durability and flexibility.'],
  ['Rheological testing', 'Smooth flow and consistent extrusion.'],
  ['Printer testing', 'Real-world performance on our own printers.'],
];
const brands = ['Bajaj', 'Surya', 'Godrej', 'Symphony', 'IFB', 'Crompton'];
const YT = 'https://youtu.be/UjGvlBgBbrY';
const ld = { '@context': 'https://schema.org', '@type': 'AboutPage', name: 'About NFIL3D', url: 'https://nfil3d.com/about-us/',
  description: 'NFIL3D is a 3D printing solutions brand backed by 37+ years of experience in engineering plastic compounds and biopolymers.' };
---
<Base title="About NFIL3D: Engineering Possibilities, Layer by Layer" description="NFIL3D makes 3D printers and filament and supplies 3D pens, resins, scanners and spares, backed by 37+ years in engineering plastics, a 4 lakh sq. ft. facility and an in-house testing lab." jsonld={ld}>
  <section class="wrap ah">
    <div class="stack gap-16">
      <span class="eyebrow gold">About NFIL3D</span>
      <h1 class="h-display">Engineering possibilities. <br>Layer by layer.</h1>
      <p class="lead">Decades of polymer expertise. A new world of 3D printing.</p>
    </div>
    <a class="story-link" href="/brand-story/">Discover our story <span aria-hidden="true">→</span></a>
  </section>

  <a class="ah-img reveal" href={YT} target="_blank" rel="noopener" aria-label="Watch the NFIL3D corporate video on YouTube">
    <img src="/images/nfil3d-video.webp" width="1054" height="572" alt="NFIL3D filament spools and printed figures in front of the Nahata wall" fetchpriority="high">
  </a>

  <section class="wrap">
    <ul class="stats">{stats.map(([n, l]) => <li class="reveal"><strong>{n}</strong><span>{l}</span></li>)}</ul>
  </section>

  <section class="wrap section story">
    <div class="stack gap-16">
      <span class="eyebrow gold">Our story</span>
      <h2 class="h-1">Built on experience. <br>Driven by possibility.</h2>
    </div>
    <div class="stack gap-12 story-t">
      <p class="reveal">N-Fil3D was founded by people with more than 37 years of experience manufacturing engineering plastic compounds and biopolymers, serving clients such as IFB, Crompton, Bajaj, Surya, Godrej and Symphony.</p>
      <p class="reveal muted">We manufacture high-quality 3D printers and 3D filaments, and supply 3D pens, resins, scanners, spares and accessories: one partner for everything 3D printing.</p>
    </div>
  </section>

  <section class="section offer">
    <div class="wrap">
      <span class="eyebrow gold">Our offering</span>
      <h2 class="h-1 offer-h">One partner. <br>Complete 3D printing solutions.</h2>
      <div class="ogrid">
        {offers.map(([t, h, im], i) => (
          <a class="ocard reveal" href={h} style={`--d:${i * 0.06}s`}>
            <span class="oimg">{im && <img src={im.src} srcset={im.srcset} sizes="(max-width: 760px) 45vw, 300px" alt={im.alt || t} width="600" height="600" loading="lazy">}</span>
            <span class="olabel">{t} <span class="arr" aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="fac">
    <div class="fac-img reveal"><img src="/images/hero-desktop.webp" width="1448" height="1086" alt="Measuring NFIL3D filament diameter with a digital caliper" loading="lazy"></div>
    <div class="fac-t">
      <span class="eyebrow gold">Our facility</span>
      <h2 class="h-1">Quality, tested <br>at every stage.</h2>
      <p class="muted">Our 4 lakh sq. ft. facility has an in-house lab that tests the thermal, mechanical and rheological properties of every batch of filament, then proves it on 3D printers, including our own.</p>
      <ul class="tests">{tests.map(([t, d]) => <li class="reveal"><strong>{t}</strong><span class="muted">{d}</span></li>)}</ul>
    </div>
  </section>

  <section class="wrap section-sm">
    <a class="vband reveal" href={YT} target="_blank" rel="noopener">
      <span class="vthumb"><img src="/images/nfil3d-video.webp" width="1054" height="572" alt="" loading="lazy"><span class="vplay-sm" aria-hidden="true">▶</span></span>
      <span class="vtext"><strong>See NFIL3D in action.</strong><span>From materials to manufacturing, a closer look at our process and possibilities.</span></span>
      <span class="vplay" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></span>
    </a>
  </section>

  <section class="wrap section-sm brands">
    <span class="eyebrow gold">Trusted experience</span>
    <h2 class="h-2">Experience serving leading brands</h2>
    <ul class="blist">{brands.map((b) => <li>{b}</li>)}</ul>
    <p class="note muted">Brand names belong to their owners and refer to our founders' prior experience.</p>
  </section>

  <CtaBand title="Let's build what's next." href="/contact/" label="Talk to our team" />
</Base>
<style>
  .gold { color: #C99A00; }
  .ah { display: flex; flex-wrap: wrap; gap: 24px; justify-content: space-between; align-items: flex-end; padding-block: clamp(32px, 6vw, 72px) 32px; }
  .ah h1 { font-size: clamp(2.6rem, 6vw, 5.6rem); line-height: .98; }
  .ah .lead { margin: 0; }
  .story-link { font-weight: 600; text-decoration: none; padding-bottom: 6px; border-bottom: 2px solid var(--sun); }
  .story-link span { color: #C99A00; }
  .ah-img { display: block; position: relative; height: clamp(260px, 36vw, 560px); overflow: hidden; clip-path: polygon(0 12%, 100% 0, 100% 100%, 0 100%); }
  .ah-img img { width: 100%; height: 100%; object-fit: cover; object-position: center 60%; }
  .stats { list-style: none; margin: 0; padding: clamp(24px, 3vw, 40px) 0; display: grid; grid-template-columns: repeat(3, 1fr); border-bottom: 1px solid var(--line); }
  .stats li { display: flex; flex-direction: column; gap: 4px; padding: 0 clamp(16px, 3vw, 40px); }
  .stats li + li { border-left: 1px solid var(--line); }
  .stats strong { font-size: clamp(1.6rem, 3vw, 2.6rem); font-weight: 600; letter-spacing: -0.04em; }
  .stats span { color: var(--muted); }
  .story { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 80px); align-items: center; }
  .story-t p { margin: 0; font-size: 1.05rem; }
  .offer { background: var(--surface-2); }
  .offer-h { margin: 12px 0 32px; }
  .ogrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .ocard { display: flex; flex-direction: column; background: var(--surface); border-radius: var(--radius); overflow: hidden; text-decoration: none; transition: transform .45s var(--ease), box-shadow .45s var(--ease); }
  .ocard:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .oimg { aspect-ratio: 5 / 4; background: #fff; overflow: hidden; }
  .oimg img { width: 100%; height: 100%; object-fit: contain; transition: transform .7s var(--ease); }
  .ocard:hover .oimg img { transform: scale(1.05); }
  .olabel { padding: 16px 18px; font-weight: 600; display: flex; gap: 10px; align-items: center; border-top: 1px solid var(--line); }
  .arr { color: #C99A00; transition: transform .3s var(--ease); }
  .ocard:hover .arr { transform: translateX(4px); }
  .fac { display: grid; grid-template-columns: 1.1fr 1fr; align-items: center; gap: clamp(28px, 5vw, 72px); padding-block: clamp(28px, 4vw, 48px); }
  .fac-img { height: 100%; min-height: 380px; overflow: hidden; border-radius: 0 var(--radius-lg) var(--radius-lg) 0; }
  .fac-img img { width: 100%; height: 100%; object-fit: cover; }
  .fac-t { display: flex; flex-direction: column; gap: 14px; padding-right: max(24px, calc((100vw - var(--max)) / 2 + 24px)); }
  .fac-t p { margin: 0; }
  .tests { list-style: none; margin: 8px 0 0; padding: 0; }
  .tests li { display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-top: 1px solid var(--line); font-size: .95rem; }
  .tests li span { text-align: right; font-size: .86rem; }
  .vband { display: grid; grid-template-columns: minmax(180px, 34%) 1fr auto; gap: clamp(16px, 3vw, 40px); align-items: center; padding: 14px; border-radius: var(--radius-lg); background: #111110; color: #F4F2EC; text-decoration: none; }
  .vthumb { position: relative; display: block; aspect-ratio: 16 / 7; border-radius: var(--radius); overflow: hidden; }
  .vthumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .7s var(--ease); }
  .vband:hover .vthumb img { transform: scale(1.05); }
  .vplay-sm { position: absolute; inset: 0; margin: auto; width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; border: 2px solid #fff; color: #fff; background: rgba(0,0,0,.25); }
  .vtext { display: flex; flex-direction: column; gap: 6px; }
  .vtext strong { font-size: clamp(1.2rem, 2vw, 1.6rem); font-weight: 600; letter-spacing: -0.02em; }
  .vtext span { color: #BDB9B0; font-size: .95rem; }
  .vplay { width: 72px; height: 72px; margin-right: clamp(8px, 2vw, 24px); border-radius: 50%; display: grid; place-items: center; background: var(--sun); color: #111110; padding-left: 4px; transition: transform .4s var(--ease); }
  .vband:hover .vplay { transform: scale(1.1); }
  .brands { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .blist { list-style: none; margin: 14px 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; }
  .blist li { padding: 6px clamp(16px, 3vw, 36px); font-size: clamp(1.05rem, 1.6vw, 1.35rem); font-weight: 600; color: var(--ink-2); }
  .blist li + li { border-left: 1px solid var(--line); }
  .note { font-size: .78rem; margin: 6px 0 0; }
  @media (max-width: 900px) {
    .story, .fac { grid-template-columns: 1fr; }
    .fac-img { border-radius: 0; min-height: 260px; }
    .fac-t { padding: 0 18px; }
    .ogrid { grid-template-columns: repeat(2, 1fr); }
    .vband { grid-template-columns: 1fr; } .vplay { display: none; }
  }
  @media (max-width: 600px) { .stats { grid-template-columns: 1fr; } .stats li + li { border-left: 0; border-top: 1px solid var(--line); padding-top: 14px; margin-top: 14px; } .tests li { flex-direction: column; gap: 2px; } .tests li span { text-align: left; } }
</style>
