---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { SITE } from '../config/site';
// CONFIRM with NFIL3D before launch: founding year, facility location, Nahata Group wording, Made in India.
---
<Base title="The NFIL3D Story: 37+ Years in Engineering Plastics" description="NFIL3D is backed by 37+ years in engineering plastic compounds and biopolymers, with a 4 lakh sq. ft. facility and an in-house filament testing lab.">
  <PageHead crumb="Our story" eyebrow="Our story" title='The NFIL3D <span class="serif">story.</span>' lead="NFIL3D was founded by people with more than 37 years of experience in manufacturing engineering plastic compounds and biopolymers. That background shapes everything we make: filament is a plastics product first, and getting the material right is what makes a print succeed." />
  <section class="wrap section-sm">
    <ul class="facts">
      <li class="reveal"><span class="num">{SITE.facts.years}</span><span>years in engineering plastics and biopolymers</span></li>
      <li class="reveal" style="--d:.05s"><span class="num">4 lakh</span><span>sq. ft. manufacturing facility</span></li>
      <li class="reveal" style="--d:.1s"><span class="num">In-house</span><span>lab for filament testing</span></li>
      <li class="reveal" style="--d:.15s"><span class="num">{SITE.facts.tolerance}</span><span>diameter tolerance</span></li>
    </ul>
  </section>
  <section class="wrap section floor">
    <div class="ftext stack gap-16">
      <span class="eyebrow gold">From our floor</span>
      <h2 class="h-1">From our floor. <br><span class="hl">To your next idea.</span></h2>
      <p class="lead">Every spool is checked, packed and sealed by our own team before it leaves the facility.</p>
      <p class="muted">Explore the journey behind our 3D printing filament: from raw material to a packed, desiccant-sealed spool that prints right first time.</p>
    </div>
    <div class="fart">
      <figure class="ph ph-team reveal"><img src="/images/story/team.webp" width="910" height="660" alt="NFIL3D team packing a filament spool" loading="lazy"></figure>
      <figure class="ph ph-spool reveal" style="--d:.1s"><img src="/images/story/spool.webp" width="660" height="310" alt="Sealed NFIL3D Premium High Strength PLA spool with desiccant" loading="lazy"><figcaption>Sealed with desiccant</figcaption></figure>
    </div>
  </section>

  <section class="wrap section ware">
    <div class="wgrid">
      <figure class="ph ph-ware reveal"><img src="/images/story/warehouse.webp" width="1216" height="678" alt="NFIL3D warehouse with stacked raw material" loading="lazy"><figcaption>Raw material storage</figcaption></figure>
      <figure class="ph ph-line reveal" style="--d:.08s"><img src="/images/story/line.webp" width="588" height="388" alt="NFIL3D filament extrusion line" loading="lazy"><figcaption>Extrusion line</figcaption></figure>
      <figure class="ph ph-mach reveal" style="--d:.16s"><img src="/images/story/machine.webp" width="612" height="388" alt="NFIL3D automatic spool winding machine" loading="lazy"><figcaption>Automatic spooling</figcaption></figure>
    </div>
    <div class="wtext stack gap-16">
      <span class="eyebrow">Warehousing &amp; manufacturing</span>
      <h2 class="h-1">Big space. <br>Strong manufacturing.</h2>
      <p class="lead">Our spacious warehouse supports material storage and manufacturing operations across a 4 lakh sq. ft. facility.</p>
      <ul class="wlist"><li>Raw material stored dry and organised</li><li>In-line extrusion with diameter control</li><li>Automatic winding and packing</li></ul>
    </div>
  </section>

  <section class="wrap section-sm two">
    <div class="stack gap-16"><h2 class="h-2">What we make</h2><p class="lead">1.75 mm filament in PLA+, PETG, HI ABS+, ASA, ABS FR, HIPS, nylon and carbon fibre, along with our own Mini-N, N1 and N2 3D printers, 3D pens and accessories. We also bring Halot resin printers and 3D scanners to makers in India.</p></div>
    <div class="stack gap-16"><h2 class="h-2">Our promise</h2>
      <ul class="promise"><li>Lifetime warranty on filament against manufacturing defects</li><li>1-year warranty on NFIL3D 3D printers</li><li>Free shipping across India</li><li>Real people on phone, email and WhatsApp, {SITE.hours}</li></ul>
    </div>
  </section>
  <section class="wrap section-sm"><a class="btn btn-accent btn-lg" href="/product-category/3d-printer-filaments/">Shop filament <span class="arrow" aria-hidden="true">→</span></a></section>
</Base>
<style>
  .facts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); border-top: 1px solid var(--line); }
  .facts li { display: flex; flex-direction: column; gap: 6px; padding: 28px 24px 28px 0; border-bottom: 1px solid var(--line); }
  .num { font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -0.04em; font-weight: 500; }
  .facts li span:last-child { color: var(--muted); }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  @media (max-width: 800px) { .two { grid-template-columns: 1fr; } }
  .gold { color: #C99A00; }
  .floor, .ware { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(28px, 5vw, 72px); align-items: center; }
  .ware { grid-template-columns: 1.3fr 1fr; }
  .floor .h-1, .ware .h-1 { margin: 0; font-size: clamp(2rem, 3.6vw, 3.4rem); line-height: 1; }
  .hl { color: #B08300; }
  .floor p, .ware p { margin: 0; }
  .ph { margin: 0; position: relative; overflow: hidden; border-radius: var(--radius-lg); box-shadow: 0 30px 60px -34px rgba(17,17,16,.45); }
  .ph img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .9s var(--ease); }
  .ph:hover img { transform: scale(1.04); }
  .ph figcaption { position: absolute; left: 12px; bottom: 12px; padding: 6px 12px; border-radius: 999px; background: rgba(255,255,255,.9); backdrop-filter: blur(8px); color: #111110; font-size: .78rem; font-weight: 600; }
  .fart { position: relative; aspect-ratio: 5 / 4; }
  .floor { overflow-x: clip; }
  .ph-team { position: absolute; left: 0; top: 0; width: 78%; aspect-ratio: 910 / 660; }
  .ph-spool { position: absolute; right: 0; bottom: 0; width: 54%; aspect-ratio: 660 / 310; border: 6px solid var(--bg); }
  .wgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; position: relative; }
  .wgrid::before { content: ''; position: absolute; left: -14px; top: 8%; bottom: 8%; width: 6px; border-radius: 6px; background: var(--sun); }
  .ph-ware { grid-column: 1 / -1; aspect-ratio: 1216 / 640; }
  .ph-line, .ph-mach { aspect-ratio: 3 / 2; }
  .ph-mach { transform: translateY(26px); }
  .wlist { margin: 4px 0 0; padding: 0; list-style: none; display: grid; gap: 10px; }
  .wlist li { padding-left: 22px; position: relative; color: var(--ink-2); }
  .wlist li::before { content: ''; position: absolute; left: 0; top: .5em; width: 10px; height: 10px; border-radius: 50%; background: var(--sun); }
  @media (max-width: 900px) { .floor, .ware { grid-template-columns: 1fr; } .ware .wtext { order: -1; } .fart { aspect-ratio: 1 / 1; } .ph-team { width: 92%; } .ph-spool { width: 70%; } .ph-mach { transform: none; } }
  .promise { margin: 0; padding-left: 1.1em; display: flex; flex-direction: column; gap: 8px; color: var(--ink-2); }
</style>
