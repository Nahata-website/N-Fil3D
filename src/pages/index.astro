---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import Finder from '../components/Finder.astro';
import Faq from '../components/Faq.astro';
import { products, catBySlug, productsIn, posts, inr, family, swatch, colourName, isFilament } from '../lib/data';
import { FAQ } from '../data/content';
import { SITE } from '../config/site';

const bySlug = (s: string) => productsIn(catBySlug.get(s)!.id).filter((p) => p.inStock);
const pick = (list: typeof products, n = 4) => {
  const seen = new Set<string>(); const out = [];
  for (const p of list) { const k = family(p)[0]?.id + ''; if (!seen.has(k)) { seen.add(k); out.push(p); } if (out.length >= n) break; }
  return out.length >= n ? out : list.slice(0, n);
};
const tabs = [
  { key: 'pla', label: 'PLA+', items: bySlug('pla').slice(0, 4) },
  { key: 'petg', label: 'PETG', items: bySlug('petg').slice(0, 4) },
  { key: 'abs', label: 'ABS & ASA', items: [...bySlug('abs-3d-printer-filaments').slice(0, 2), ...bySlug('asa-cat').slice(0, 1), ...bySlug('abs-fr').slice(0, 1)] },
  { key: 'special', label: 'Speciality', items: pick([...bySlug('pla_tf'), ...bySlug('matte_pla'), ...bySlug('pla_cf'), ...bySlug('pla_lw'), ...bySlug('3d-pens-filaments')]) },
];
const railFrom = (list: typeof products) => {
  const first = list.find((p) => p.images.length) || list[0];
  const file = (u?: string) => (u || '').split('/').pop()?.replace(/-\d+x\d+(?=\.)/, '');
  const pool = [...(first?.images.slice(1) || []), ...list.filter((p) => p !== first).map((p) => p.images[0])];
  const second = pool.find((im) => im && file(im.src) !== file(first?.images[0]?.src));
  return { img: first?.images[0], img2: second };
};
const cats = [
  { name: 'Filament', href: '/product-category/3d-printer-filaments/', ...railFrom(bySlug('pla')) },
  { name: '3D Printers', href: '/printers/', ...railFrom(productsIn(catBySlug.get('fdm-3d-printers')!.id)) },
  { name: '3D Pens', href: '/product-category/3d-pen/', ...railFrom(productsIn(catBySlug.get('3d-pen')!.id)) },
  { name: 'Resin printers', href: '/product-category/3d-printers/resin-3d-printers/', ...railFrom(productsIn(catBySlug.get('resin-3d-printers')!.id)) },
  { name: 'Scanners', href: '/product-category/3d-scanner/', ...railFrom(productsIn(catBySlug.get('3d-scanner')!.id)) },
  { name: 'Spares', href: '/product-category/accessories-and-spares/', ...railFrom(productsIn(catBySlug.get('accessories-and-spares')!.id)) },
];
// Filament tile: hover swaps to a different colour spool
const altSpool = products.find((p) => p.slug === 'premium-pla-emerald-green-1-75mm' && p.images.length);
if (altSpool) cats[0].img2 = altSpool.images[0];
// Scanners tile: hover swaps Mole for the Magic Swift Plus scanner
const swift = products.find((p) => p.slug === 'magic-swift-plus-3d-scanner-premium' && p.images.length);
if (swift) cats[4].img2 = swift.images[0];
// Hero: three spools — big in the centre, two smaller at the sides
const heroSpools = ['premium-pla-tangy-orange-1-75mm', 'premium-pla-emerald-green-1-75mm', 'premium-pla-electric-blue-1-75mm']
  .map((s) => products.find((p) => p.slug === s)).filter((p): p is (typeof products)[number] => !!p && p.images.length > 0);
// Banner slides 2–4
const bySlugAny = (slug: string) => products.find((p) => p.slug === slug && p.images.length > 0);
// Slide 2: printers only (outer → inner), N2 in the centre
// Clean PNG cutouts supplied by the brand team
const PR_IMG: Record<string, string> = { 'halot-sky': 'halot-sky', 'halot-one': 'halot-one', 'mini-n-3d-printer': 'mini-n', 'n2-3d-printer': 'n2', 'n1-3d-printer': 'n1', 'halot-max': 'halot-max', 'all-in-one-washing-and-curing-station-uw-02': 'uw02' };
const s2Printers = [
  ['halot-sky', 'pr-l3', 'Halot Sky'], ['halot-one', 'pr-l2', 'Halot One'], ['mini-n-3d-printer', 'pr-l1', 'Mini-N'],
  ['n2-3d-printer', 'pr-c', 'N2'],
  ['n1-3d-printer', 'pr-r1', 'N1'], ['halot-max', 'pr-r2', 'Halot Max'], ['all-in-one-washing-and-curing-station-uw-02', 'pr-r3', 'UW-02'],
].map(([slug, cls, label]) => ({ p: bySlugAny(slug), cls, label })).filter((x) => x.p);
const s3Spools = ['premium-pla-fluoro-green-1-75mm', 'premium-pla-daffodil-yellow-1-75mm-2', 'premium-pla-deep-blue-1-75mm', 'premium-pla-tangy-orange-1-75mm'].map(bySlugAny).filter((p): p is (typeof products)[number] => !!p);
const flags = [0, 1, 2, 3, 4, 5, 6, 7].map((k) => { const x = 30 + k * 72; const y = 10 + Math.sin((x / 600) * Math.PI) * 30; return { pts: `${x - 22},${y} ${x + 22},${y + 2} ${x},${y + 46}`, fill: k % 2 ? '#FFC21A' : '#FF7A1A' }; });
const dots14 = Array.from({ length: 14 }, (_, i) => i);
const dots9 = Array.from({ length: 9 }, (_, i) => i);
// Colour wall: one swatch per distinct colour name across PLA+ and PETG
const wall: { name: string; hex: string; href: string }[] = [];
const seen = new Set<string>();
for (const p of [...bySlug('pla'), ...bySlug('petg'), ...bySlug('pla_tf')]) {
  const n = colourName(p); const k = n.toLowerCase();
  if (!seen.has(k) && n.length < 24) { seen.add(k); wall.push({ name: n, hex: swatch(p.name), href: p.path }); }
}
const printers = ['mini-n-3d-printer', 'n1-3d-printer', 'n2-3d-printer'].map((s) => products.find((p) => p.slug.startsWith(s))).filter(Boolean) as typeof products;
const printerNotes: Record<string, string> = { 'Mini-N': 'Compact. For desks, homes and classrooms.', N1: 'All-rounder for prototypes and parts.', N2: 'Sturdier frame for bigger, longer prints.' };
---
<Base
  title="3D Printers & Filament Online in India | NFIL3D"
  description="Shop 3D printers, PLA, PETG and ABS filament, 3D pens and scanners from NFIL3D. Lifetime warranty on filament and free shipping across India."
>

  <section class="hero">
    <div class="slides" data-slider aria-roledescription="carousel" aria-label="Featured">
    <div class="slide is-active" data-slide="0" aria-roledescription="slide" aria-label="1 of 4">
    <div class="wrap hero-in">
      <div class="stack gap-24 hero-copy">
        <span class="eyebrow reveal">1.75 mm filament · {SITE.facts.years} years in plastics</span>
        <h1 class="h-display reveal" style="--d:.05s">Precision you can <span class="serif">measure.</span></h1>
        <p class="lead reveal" style="--d:.1s">PLA+, PETG, HI ABS+ and engineering grades held to <strong>{SITE.facts.tolerance}</strong>. Packed dry, backed by a lifetime warranty, from ₹699 a spool.</p>
        <div class="row gap-12 reveal" style="--d:.15s">
          <a class="btn btn-accent btn-lg" href="/product-category/3d-printer-filaments/">Shop filament <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn-ghost btn-lg" href="#finder">Find your filament</a>
        </div>
      </div>
      <div class="hero-visual reveal" style="--d:.1s">
        {heroSpools.map((p, i) => (
          <a class={`spool spool-${['l', 'c', 'r'][i]}`} href={p.path} aria-label={colourName(p)}>
            <img src={`/images/spool-${['orange', 'green', 'blue'][i]}.webp`} alt={`NFIL3D PLA+ filament spool, ${colourName(p)}`} width="480" height="680" fetchpriority={i === 1 ? 'high' : undefined} loading={i === 1 ? undefined : 'lazy'}>
            <span class="spool-tag"><span>{colourName(p)}</span></span>
          </a>
        ))}
      </div>
    </div>
    </div>

    <div class="slide s2" data-slide="1" aria-roledescription="slide" aria-label="2 of 4" aria-hidden="true" inert>
      <div class="wrap s2-in">
        <div class="s2-copy">
          <p class="h-display s-title">Your ideas. <span class="serif s2-gold">Made real</span>.</p>
          <p class="lead s-sub">FDM and resin 3D printers for homes, classrooms and workshops, plus washing and curing for finished resin prints.</p>
          <div class="row gap-12 s-cta">
            <a class="btn btn-accent btn-lg" href="/printers/">Shop printers <span class="arrow" aria-hidden="true">→</span></a>
            <a class="btn btn-ghost btn-lg" href="/product-category/3d-printers/resin-3d-printers/">Resin printers <span class="arrow" aria-hidden="true">→</span></a>
          </div>
          <ul class="s2-trust s-sub">
            <li><svg width="30" height="30" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M3 9h16v13H3zM19 13h5.5l4.5 5v4h-10z"/><circle cx="9" cy="24" r="2.6" fill="var(--bg)"/><circle cx="23.5" cy="24" r="2.6" fill="var(--bg)"/></svg>Fast &amp; reliable shipping</li>
            <li><svg width="30" height="30" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M2 12l14-6 14 6-14 6z"/><path d="M8 15v6c4 3.5 12 3.5 16 0v-6"/><path d="M28 13v7"/></svg>Trusted by schools &amp; makers</li>
            <li><svg width="30" height="30" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M16 3l11 4v8c0 7-4.6 11.6-11 14C9.6 26.6 5 22 5 15V7z"/><path d="M11 16l3.5 3.5L21 13" stroke="#E0A800" stroke-width="2.4" stroke-linecap="round"/></svg>Quality products &amp; support</li>
          </ul>
        </div>
        <div class="s2-stage s-stage">
          <div class="arc s-shape" aria-hidden="true"></div>
          <div class="podium" aria-hidden="true"></div>
          {s2Printers.map(({ p, cls, label }) => (
            <a class={`s-spool s-pr ${cls}`} href={p!.path} aria-label={p!.shortName}>
              <img src={`/images/pr-${PR_IMG[p!.slug]}.webp`} alt={`${label} 3D printer`} loading="lazy" decoding="async" width="500" height="800">
              <span class="spool-tag"><span>{label}</span></span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="slide s4" data-slide="2" aria-roledescription="slide" aria-label="4 of 4" aria-hidden="true" inert>
      <div class="wrap s-split">
        <div class="stack gap-24">
          <span class="eyebrow s-eyebrow">3D pens</span>
          <p class="h-display s-title">Think it. Draw it. <span class="serif">Create it.</span></p>
          <p class="lead s-sub">Bring your imagination into a new dimension. Starter kits with filament, stand and stencils.</p>
          <div class="row gap-12 s-cta"><a class="btn btn-accent btn-lg" href="/product-category/3d-pen/">Explore 3D pens <span class="arrow" aria-hidden="true">→</span></a></div>
        </div>
        <div class="s4-stage s-stage">
          <div class="sun s-shape" aria-hidden="true"></div>
          <div class="disc s-shape" aria-hidden="true"></div>
          <svg class="doodle butterfly" viewBox="0 0 240 200" aria-hidden="true">
            <g fill="none" stroke="#1E5BFF" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M120 60 C 90 10, 20 0, 14 40 C 8 80, 70 96, 116 96" />
              <path d="M120 60 C 150 10, 220 0, 226 40 C 232 80, 170 96, 124 96" />
              <path d="M116 100 C 70 104, 40 140, 58 168 C 76 194, 110 160, 118 112" />
              <path d="M124 100 C 170 104, 200 140, 182 168 C 164 194, 130 160, 122 112" />
              <path d="M120 56 L120 150" stroke-width="7" />
              <path d="M118 56 C 110 36, 98 24, 88 18" /><path d="M122 56 C 130 36, 142 24, 152 18" />
              <path d="M40 34 C 60 44, 84 56, 110 74" /><path d="M200 34 C 180 44, 156 56, 130 74" />
              <path d="M30 60 C 54 66, 80 76, 108 86" /><path d="M210 60 C 186 66, 160 76, 132 86" />
              <path d="M70 140 C 84 132, 98 122, 114 108" /><path d="M170 140 C 156 132, 142 122, 126 108" />
            </g>
          </svg>
          <svg class="doodle house" viewBox="0 0 220 220" aria-hidden="true">
            <g fill="none" stroke="#FF6A1A" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 100 L110 22 L200 100" />
              <path d="M40 86 L40 200 L180 200 L180 86" />
              <path d="M150 54 L150 22 L172 22 L172 74" />
              <path d="M62 120 h36 v34 h-36 z" /><path d="M80 120 v34" /><path d="M62 137 h36" />
              <path d="M122 120 h36 v34 h-36 z" /><path d="M140 120 v34" /><path d="M122 137 h36" />
              <path d="M96 200 v-30 h28 v30" />
              <path d="M40 100 L180 180" opacity=".5" /><path d="M180 100 L40 180" opacity=".5" />
              <path d="M60 70 L160 70" opacity=".5" /><path d="M20 210 L200 210" />
            </g>
          </svg>
          <a class="s4-pen s-pen pen-0" href="/product-category/3d-pen/" aria-label="White 3D pen"><img src="/images/pen-white.webp" width="250" height="740" alt="NFIL3D 3D pen, white" loading="lazy" decoding="async"></a>
          <a class="s4-pen s-pen pen-1" href="/product-category/3d-pen/" aria-label="Pink 3D pen"><img src="/images/pen-pink.webp" width="250" height="740" alt="NFIL3D 3D pen, pink" loading="lazy" decoding="async"></a>
          <a class="s4-pen s-pen pen-2" href="/product-category/3d-pen/" aria-label="Blue 3D pen"><img src="/images/pen-blue.webp" width="250" height="740" alt="NFIL3D 3D pen, blue" loading="lazy" decoding="async"></a>
          <a class="s4-pen s-pen pen-3" href="/product-category/3d-pen/" aria-label="Yellow 3D pen"><img src="/images/pen-yellow.webp" width="250" height="740" alt="NFIL3D 3D pen, yellow" loading="lazy" decoding="async"></a>
        </div>
      </div>
    </div>

    <div class="slide s7" data-slide="3" aria-roledescription="slide" aria-hidden="true" inert>
      <div class="wrap s-split">
        <div class="stack gap-24">
          <span class="eyebrow s-eyebrow kid-eyebrow"><svg class="sparks draw" viewBox="0 0 60 40" aria-hidden="true"><g fill="none" stroke-width="4" stroke-linecap="round"><path d="M10 30 L22 22" /><path d="M24 14 L28 2" /><path d="M36 22 L52 18" /></g></svg>Big fun for little creators</span>
          <p class="s-title kid-title">Little hands. <span class="t-teal">Big imagination.</span></p>
          <p class="lead s-sub kid-sub">Turn colourful filament into amazing 3D creations.</p>
          <div class="row gap-12 s-cta">
            <a class="btn btn-accent btn-lg cta-yellow" href="/product-category/3d-pens-filaments/">Explore 3D pen filaments <span class="arrow" aria-hidden="true">→</span></a>
            <a class="btn btn-ghost btn-lg cta-outline" href="/product-category/3d-pen/">What will you create?</a>
          </div>
        </div>
        <div class="s7-stage s-stage">
          <div class="blob s-shape" aria-hidden="true"></div>
          <svg class="ribbon draw" viewBox="0 0 500 200" aria-hidden="true"><path d="M10 190 C 60 120, 160 150, 230 110 C 300 70, 330 30, 420 20" fill="none" stroke="#FFD84D" stroke-width="34" stroke-linecap="round" opacity=".85" /></svg>
          <img class="s-obj coil-img k-coils" src="/images/fest/k-coils.webp" width="1100" height="215" alt="Coils of NFIL3D 3D pen filament" loading="lazy" decoding="async">
          <a href="/product-category/3d-pens-filaments/" aria-label="3D pen filaments"><img class="s-obj k-pouch s-spool" src="/images/fest/k-pouch.webp" width="387" height="564" alt="NFIL3D 3D pen filaments pouch" loading="lazy" decoding="async"></a>
          <img class="s-obj k-rocket float" src="/images/fest/k-rocket.webp" width="193" height="214" alt="Rocket made with a 3D pen" loading="lazy" decoding="async">
          <img class="s-obj k-dino float" src="/images/fest/k-dino.webp" width="241" height="247" alt="Dinosaur made with a 3D pen" loading="lazy" decoding="async">
          <img class="s-obj k-fly float" src="/images/fest/k-fly.webp" width="204" height="192" alt="Butterfly made with a 3D pen" loading="lazy" decoding="async">
          <img class="s-obj k-star float" src="/images/fest/k-star.webp" width="126" height="123" alt="" loading="lazy" decoding="async">
          <svg class="sparks draw sp-3" viewBox="0 0 60 40" aria-hidden="true"><g fill="none" stroke-width="4" stroke-linecap="round"><path d="M10 30 L22 22" /><path d="M24 14 L28 2" /><path d="M36 22 L52 18" /></g></svg>
        </div>
      </div>
    </div>
      <button type="button" class="sarrow sprev" data-prev aria-label="Previous slide"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
      <button type="button" class="sarrow snext" data-next aria-label="Next slide"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
    </div>

    <div class="wrap slider-ui" data-slider-ui hidden>
      <div class="dots" role="tablist" aria-label="Choose slide">
        {['Filament precision', 'Your ideas, made real', '3D pens', 'Little creators'].map((label, i) => (
          <button type="button" class="dot" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-label={label} data-go={i}><span class="dot-fill"></span></button>
        ))}
      </div>
      <button type="button" class="pause" data-pause aria-label="Pause slideshow"><span class="ic-pause" aria-hidden="true"></span></button>
    </div>
    <div class="wrap">
      <ul class="trust reveal">
        <li><strong>{SITE.facts.years} years</strong><span>in engineering plastics</span></li>
        <li><strong>{SITE.facts.facility}</strong><span>manufacturing facility</span></li>
        <li><strong>In-house lab</strong><span>for filament testing</span></li>
        <li><strong>Lifetime</strong><span>filament warranty</span></li>
        <li><strong>Free shipping</strong><span>across India</span></li>
      </ul>
    </div>
  </section>

  <section class="section-sm">
    <div class="wrap">
      <ul class="rail">
        {cats.map((c, i) => (
          <li class="reveal" style={`--d:${i * 0.04}s`}>
            <a href={c.href} class="rail-item">
              <span class="rail-media">
                {c.img && <img src={c.img.src} srcset={c.img.srcset} sizes="200px" alt="" loading="lazy" width="300" height="300">}
                {c.img2 && <img class="rail-alt" src={c.img2.src} srcset={c.img2.srcset} sizes="200px" alt="" loading="lazy" width="300" height="300">}
              </span>
              <span>{c.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-sm"><div class="wrap"><Finder /></div></section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div class="stack"><span class="eyebrow">Bestsellers</span><h2 class="h-1">Loved by makers.</h2></div>
        <div class="row gap-8" role="tablist" aria-label="Bestseller category" data-tabs>
          {tabs.map((t, i) => <button type="button" class="chip" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`tab-${t.key}`} data-tab={t.key}>{t.label}</button>)}
        </div>
      </div>
      {tabs.map((t, i) => (
        <div id={`tab-${t.key}`} role="tabpanel" class="grid cols-4" hidden={i !== 0} data-panel={t.key}>
          {t.items.map((p) => <ProductCard p={p} />)}
        </div>
      ))}
      <div class="row" style="justify-content:center;margin-top:40px"><a class="btn btn-ghost" href="/shop/">View all products <span class="arrow" aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section class="section colour">
    <div class="wrap colour-in">
      <div class="stack gap-16 reveal">
        <span class="eyebrow">{wall.length}+ colours · six finishes</span>
        <h2 class="h-1">Every colour, matched <span class="serif">batch to batch.</span></h2>
        <p class="lead">Solid, matte, clear, metallic, fluorescent and glow-in-the-dark. Every spool ships with a matching colour card.</p>
        <a class="link" href="/shop/">Shop by colour <span aria-hidden="true">→</span></a>
      </div>
      <ul class="wall">
        {wall.map((w, i) => <li class="reveal" style={`--d:${(i % 12) * 0.025}s`}><a href={w.href} style={`--c:${w.hex}`} aria-label={w.name}><span class="tip">{w.name}</span></a></li>)}
      </ul>
    </div>
  </section>

  <section class="section vid" aria-labelledby="vid-h">
    <div class="vid-band" aria-hidden="true"></div>
    <div class="wrap vid-in">
      <div class="stack gap-24">
        <span class="eyebrow reveal">NFIL3D corporate video</span>
        <h2 class="h-1" id="vid-h">See NFIL3D <span class="serif">in action.</span></h2>
        <p class="lead reveal">Watch our journey, manufacturing strength and 3D printing innovation.</p>
        <div class="row reveal"><a class="btn btn-lg vid-cta" href="https://youtu.be/UjGvlBgBbrY" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l13-7.5z" fill="currentColor"/></svg>Watch full video</a></div>
      </div>
      <figure class="vid-fig reveal">
        <a class="vid-card" href="https://youtu.be/UjGvlBgBbrY" target="_blank" rel="noopener" aria-label="Play the NFIL3D corporate video on YouTube">
          <img src="/images/nfil3d-video.webp" width="1054" height="572" alt="NFIL3D filament spools and printed figures in front of the Nahata wall" loading="lazy" decoding="async">
          <span class="vid-play" aria-hidden="true"><svg width="30" height="30" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></span>
        </a>
        <figcaption class="mono muted">Corporate video · Nahata Group of Industries</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div class="stack"><span class="eyebrow">NFIL3D printers</span><h2 class="h-1">Built to print. Backed in India.</h2><p class="lead">{SITE.facts.printerWarranty}, with support by phone, email and WhatsApp.</p></div>
        <a class="btn btn-ghost" href="/printers/">Compare printers <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="grid cols-3">
        {printers.map((p, i) => (
          <a href={p.path} class="printer reveal" style={`--d:${i * 0.06}s`}>
