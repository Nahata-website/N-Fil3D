---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Catalogue from '../../components/Catalogue.astro';
import { categories, productsIn, childrenOf, ancestors, DUPLICATE_CATS, inr, discount, displayName, type Category } from '../../lib/data';
import { SITE, cartUrl } from '../../config/site';

export function getStaticPaths() {
  return categories.filter((c) => c.count > 0 && !['3d-models', '3d-pen'].includes(c.slug)).map((c) => ({
    params: { path: c.path.replace(/^\/product-category\//, '').replace(/\/$/, '') },
    props: { c },
  }));
}
const { c } = Astro.props as { c: Category };
const items = productsIn(c.id);
const subs = childrenOf(c.id).filter((s) => !DUPLICATE_CATS.has(s.slug));
const crumbs = [...ancestors(c).map((a) => ({ name: a.name, href: a.path })), { name: c.name }];
const title = c.seoTitle || `Buy ${c.name} Online in India | NFIL3D`;
const description = c.seoDescription || `Shop ${c.name} from NFIL3D, with free shipping across India and support Monday to Saturday.`;
const ld = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: c.name, url: new URL(c.path, SITE.url).href, description,
  mainEntity: { '@type': 'ItemList', numberOfItems: items.length, itemListElement: items.slice(0, 30).map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(p.path, SITE.url).href, name: p.name })) } };

const isScanner = c.slug === '3d-scanner';
const isFil = c.slug === '3d-printer-filaments';
const rich = isScanner || isFil;

// Filament range chips: a spool-coloured dot for each range
const CHIP: Record<string, string> = { 'abs-fr': '#9A9DA3', 'asa-cat': '#E6E1D6', 'abs-3d-printer-filaments': '#1E1E1E', hips: '#7A4A1E',
  'nylon-3d-printer-filaments': '#6B6E73', petg: '#1E40C8', pla: '#16803C', pla_lw: '#6D28D9', 'rpla-new-launch': '#E07020', pla_tf: '#D62828' };
const chipName = (n: string) => n.replace(/\s*\+\s*/g, '+').replace('HI ABS+', 'HI ABS+');

// Scanner details (from the product listings)
const SCAN: Record<string, { lead: string; pts: [string, string][] }> = {
  'mole-3d-scanner-for-3d-printing-premium': { lead: 'Multispectral desktop scanner for detailed, marker-free scanning.',
    pts: [['target', 'Accuracy up to 0.05 mm'], ['cube', '0.1 mm resolution, multispectral'], ['scan', 'No-marker scanning']] },
  'magic-swift-plus-3d-scanner-premium': { lead: 'Portable handheld scanner for small parts to very large objects.',
    pts: [['target', 'Accuracy up to 0.1 mm'], ['cube', 'Ultra-large format scanning'], ['gear', 'Flexible, multi-mode scanning']] },
};
const scanName = (s: string) => s.replace(/\s*\(Premium\)/, '').replace(/ for 3D Printing/, '');
const icon: Record<string, string> = {
  target: '<circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="2.5"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/>',
  cube: '<path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M4 7.5l8 4.5 8-4.5M12 12v9"/>',
  scan: '<path d="M4 8V5a1 1 0 011-1h3M16 4h3a1 1 0 011 1v3M20 16v3a1 1 0 01-1 1h-3M8 20H5a1 1 0 01-1-1v-3M4 12h16"/>',
  gear: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M2 12h3M19 12h3M4.9 19.1L7 17M17 7l2.1-2.1"/>',
  bolt: '<path d="M13 2L4 14h7l-1 8 9-12h-7z"/>',
};
---
<Base title={title} description={description} jsonld={ld} noindex={DUPLICATE_CATS.has(c.slug)}>
  {isFil && <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@500&display=swap">}
  <section class:list={['catband', { rich }]}>
   <div class="wrap" style="padding-top:20px">
    <Breadcrumbs items={crumbs} />
    <div class="hgrid">
    <div class="head">
      <div class="stack gap-16">
        <span class="eyebrow">{items.length} products</span>
        <h1 class="h-1">{c.name}</h1>
        {c.intro && <p class="lead">{c.intro}</p>}
      </div>
        {isScanner && (
        <ul class="feats">
          <li><span class="fi"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" set:html={icon.cube}></svg></span>High accuracy<br>scanning</li>
          <li><span class="fi"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" stroke="none" set:html={icon.bolt}></svg></span>For product design<br>&amp; reverse engineering</li>
          <li><span class="fi"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" set:html={icon.gear}></svg></span>Trusted by makers<br>&amp; professionals</li>
        </ul>
      )}
  </div>
   {isScanner && (
       <div class="hv hv-scan" aria-hidden="true">
         <span class="arc"></span>
         <span class="plinth p1"></span><span class="plinth p2"></span>
         <img class="obj o-mole" src="/images/cat/scan-mole.webp" width="423" height="760" alt="" fetchpriority="high">
         <img class="obj o-swift" src="/images/cat/scan-swift.webp" width="726" height="820" alt="">
       </div>
     )}
     {isFil && (
       <div class="hv hv-fil" aria-hidden="true">
         <span class="arch"></span>
         <span class="note">Build<br>Brighter<br>Ideas<svg viewBox="0 0 90 14" width="90" height="14"><path d="M3 10 Q45 1 87 6" fill="none" stroke="#FFCC1A" stroke-width="3" stroke-linecap="round"/></svg></span>
         <img class="obj s-w" src="/images/cat/spool-white.webp" width="494" height="700" alt="">
         <img class="obj s-k" src="/images/cat/spool-black.webp" width="534" height="760" alt="" fetchpriority="high">
         <img class="obj s-y" src="/images/cat/spool-yellow.webp" width="482" height="700" alt="">
       </div>
     )}
    </div>
    {subs.length > 0 && (
      <nav aria-label={`${c.name} ranges`} class:list={['row gap-8 subs', { 'subs-fil': isFil }]}>
        {subs.map((s) => (
          <a class="chip sub" href={s.path}>
            {isFil && <span class="sd" style={`--c:${CHIP[s.slug] || '#9A968E'}`}></span>}
            {isFil ? chipName(s.name) : s.name} <span class="muted">{s.count}</span>
          </a>
        ))}
      </nav>
    )}
   </div>
  </section>

  {isScanner ? (
    <section class="wrap section-sm" style="padding-top:24px">
      <div class="scan-tools">
        <span class="chip filt"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg>{items.length} scanners</span>
        <a class="muted" href="/contact/">Need help choosing? Talk to us</a>
      </div>
      <div class="scan-grid">
        {items.map((p, i) => {
          const d = SCAN[p.slug];
          const off = discount(p);
          const img = p.slug.startsWith('mole') ? '/images/cat/scan-mole.webp' : p.slug.startsWith('magic') ? '/images/cat/scan-swift.webp' : p.images[0]?.src;
          return (
            <article class="scard reveal">
              <a class="sm" href={p.path} aria-label={displayName(p)}>
                <img src={img} alt={p.images[0]?.alt || p.name} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" width="600" height="600">
                <span class="badges">
                  {off > 0 && <span class="pill pill-sale">−{off}%</span>}
                  {!p.inStock && <span class="pill pill-oos">Out of stock</span>}
                </span>
              </a>
              <div class="sb">
                <h2><a href={p.path}>{scanName(p.name)}</a></h2>
                {d && <p class="muted">{d.lead}</p>}
                {d && (
                  <ul class="pts">
                    {d.pts.map(([ic, t]) => <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" set:html={icon[ic]}></svg>{t}</li>)}
                  </ul>
                )}
                <div class="sp"><strong>{inr(p.price)}</strong>{off > 0 && <s>{inr(p.regularPrice)}</s>}</div>
                {p.inStock
                  ? <a class="btn sbtn" href={p.path}>View details <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
                  : <a class="btn sbtn off" href={p.path}>Out of stock · view details</a>}
              </div>
            </article>
          );
        })}
      </div>
    </section>
  ) : (
    <section class="wrap section-sm" style="padding-top:24px">
      <Catalogue items={items} />
    </section>
  )}
</Base>
<style>
  .catband { background: var(--surface-2); padding-bottom: 20px; margin-bottom: 8px; position: relative; overflow: hidden; }
  .catband > .wrap { position: relative; z-index: 2; }
  .head { padding: 28px 0 20px; max-width: 760px; }
  .head h1 { font-size: clamp(2.4rem, 5vw, 4.4rem); line-height: .98; letter-spacing: -.03em; }
  .head .eyebrow { color: #C99A00; }
  .sub { background: var(--surface); }
  .subs { margin-bottom: 8px; }
  .sub { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; }

  /* Rich hero (scanner, filaments) */
  .rich { padding-bottom: 32px; }
  .hgrid { display: block; }
  .rich .hgrid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 24px; align-items: center; }
  .rich .head { max-width: 640px; }
  .hv { position: relative; height: 430px; pointer-events: none; }
  .obj { position: absolute; height: auto; filter: drop-shadow(0 24px 28px rgba(17,17,16,.18)); }

  .hv-scan .arc { position: absolute; width: 78%; aspect-ratio: 1; right: -6%; top: 4%; border-radius: 50%;
    background: radial-gradient(circle, transparent 62%, var(--sun) 62.5%, #FFD94D 73%, transparent 73.5%); opacity: .9; }
  .hv-scan .plinth { position: absolute; bottom: -32px; border-radius: 8px 8px 0 0; background: linear-gradient(160deg, #fff, #E9EAEE); box-shadow: inset 0 1px 0 #fff, 0 -6px 30px rgba(17,17,16,.06); }
  .hv-scan .p1 { left: 6%; width: 38%; height: 26%; }
  .hv-scan .p2 { right: 0; width: 48%; height: 40%; }
  .o-mole { height: 74%; width: auto; left: 12%; bottom: 18%; }
  .o-swift { height: 66%; width: auto; right: 4%; bottom: 30%; }

  .hv-fil .arch { position: absolute; width: 70%; aspect-ratio: 1; left: 24%; top: 0; border-radius: 50%; background: radial-gradient(circle at 50% 40%, #fff, #ECEDF0 70%); }
  .hv-fil .note { position: absolute; left: 0; top: 14%; font-family: 'Caveat', 'Segoe Script', cursive; font-size: clamp(1.5rem, 2.2vw, 2.2rem); line-height: 1; color: #55534E; transform: rotate(-8deg); }
  .hv-fil .note svg { display: block; margin-top: 6px; }
  .s-w { height: 62%; width: auto; left: 16%; bottom: 2%; z-index: 1; }
  .s-k { height: 78%; width: auto; left: 38%; bottom: 8%; }
  .s-y { height: 60%; width: auto; right: 0; bottom: 3%; z-index: 1; }

  .feats { list-style: none; display: flex; flex-wrap: wrap; gap: 14px 22px; padding: 0; margin: 22px 0 4px; font-size: .95rem; line-height: 1.35; }
  .feats li { display: flex; align-items: center; gap: 10px; font-size: .9rem; }
  .fi { width: 46px; height: 46px; border-radius: 50%; display: grid; place-items: center; background: color-mix(in srgb, var(--sun) 32%, var(--surface)); color: var(--ink); flex: none; }

  .subs-fil { margin-top: 12px; max-width: 100%; }
  .subs-fil .sub { padding: 8px 16px 8px 8px; box-shadow: 0 1px 2px rgba(17,17,16,.05); }
  .sd { width: 28px; height: 28px; border-radius: 50%; background: radial-gradient(circle, #fff 0 18%, #3a3a3a 19% 27%, var(--c) 28%); box-shadow: inset 0 0 0 1px rgba(0,0,0,.08); }

  /* Scanner listing */
  .scan-tools { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 20px; flex-wrap: wrap; }
  .filt { display: inline-flex; align-items: center; gap: 10px; background: var(--surface-2); border-color: transparent; }
  .scan-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .scard { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 24px; padding: 14px; border: 1px solid var(--line); border-radius: 22px; background: var(--surface); align-items: stretch; }
  .sm { position: relative; min-width: 0; width: 100%; align-self: start; display: grid; place-items: center; background: var(--surface-2); border-radius: 16px; aspect-ratio: 1; overflow: hidden; }
  .sm img { position: absolute; inset: 14%; width: 72%; height: 72%; object-fit: contain; transition: transform .5s cubic-bezier(.2,.8,.2,1); filter: drop-shadow(0 18px 20px rgba(17,17,16,.16)); }
  .scard:hover .sm img { transform: scale(1.05) rotate(-2deg); }
  .badges { position: absolute; top: 12px; left: 12px; display: flex; gap: 8px; }
  .pill-oos { background: #FDE8E8; color: #B42318; }
  .sb { display: flex; flex-direction: column; gap: 10px; padding: 10px 8px 6px 0; }
  .sb h2 { font-size: clamp(1.3rem, 1.8vw, 1.6rem); letter-spacing: -.02em; }
  .sb h2 a { text-decoration: none; color: inherit; }
  .pts { list-style: none; padding: 0; margin: 4px 0 6px; display: grid; gap: 10px; font-size: .92rem; }
  .pts li { display: flex; gap: 12px; align-items: center; }
  .sp { display: flex; align-items: baseline; gap: 10px; border-top: 1px solid var(--line); padding-top: 14px; margin-top: auto; }
  .sp strong { font-size: 1.6rem; letter-spacing: -.02em; }
  .sp s { color: var(--muted); }
  .sbtn { justify-content: center; background: var(--sun); color: #111110; border: 0; width: 100%; }
  .sbtn.off { background: color-mix(in srgb, var(--sun) 28%, var(--surface)); color: color-mix(in srgb, #111110 60%, transparent); }

  @media (max-width: 1100px) { .scan-grid { grid-template-columns: 1fr; } }
  @media (max-width: 900px) {
    .rich .hgrid { grid-template-columns: 1fr; }
    .hv { height: 320px; }
  }
  @media (max-width: 560px) {
    .scard { grid-template-columns: 1fr; }
    .hv { height: 250px; }
    .feats { gap: 12px 20px; font-size: .88rem; }
    .fi { width: 44px; height: 44px; }
    .subs-fil { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 6px; scrollbar-width: none; }
    .subs-fil .sub { flex: none; }
  }
  :global([data-theme='dark']) .hv-scan .plinth { background: linear-gradient(160deg, #2a2b2f, #1d1e21); box-shadow: none; }
  :global([data-theme='dark']) .hv-fil .arch { background: radial-gradient(circle at 50% 40%, #2a2b2f, #1b1c1f 70%); }
  :global([data-theme='dark']) .hv-fil .note { color: #CFCBC2; }
</style>
