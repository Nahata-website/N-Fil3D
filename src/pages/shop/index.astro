---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Catalogue from '../../components/Catalogue.astro';
import { products, material } from '../../lib/data';
const order = ['pla', 'petg', 'abs', 'special', 'pen', 'printer', 'other'];
const items = [...products].filter((p) => !/models/i.test(p.name) || true).sort((a, b) => (Number(b.inStock) - Number(a.inStock)) || order.indexOf(material(a)) - order.indexOf(material(b)));
---
<Base title="Shop 3D Printers, Filament & 3D Pens | NFIL3D" description="Browse every NFIL3D product in one place: FDM and resin 3D printers, 1.75 mm PLA, PETG and ABS filament, 3D pens, scanners and spares.">
  <PageHead crumb="Shop" eyebrow={`${products.length} products`} title="Shop everything." lead="Filament, printers, pens and spares. Search by colour or material, or filter below." image="/images/printers-lineup.webp" imageAlt="NFIL3D 3D printers" />
  <section class="wrap section-sm" style="padding-top:8px"><Catalogue items={items} search /></section>
</Base>
